__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# OSM extracts are large and re-downloadable from Geofabrik; never commit them.
# Match any .pbf, not just .osm.pbf -- extracts are often renamed on download.
*.pbf
*.osm.pbf
*.osm.bz2
*.osm

# EXCEPTION, THIS BRANCH ONLY: tmp2 exists to hand an extract to a session that
# cannot reach download.geofabrik.de. Do not merge this branch -- the rule above
# is there because these files stay in the history forever.
!urb_inspect/data/*.pbf

# OSMnx caches Overpass/Nominatim responses next to wherever it is run.
# Regenerated on demand, and megabytes of it.
cache/
**/cache/

# IDE project settings
.idea/
.vscode/

# generated results
out/
out_*/
